NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/solana_token_intelligence
TELEGRAM_BOT_TOKEN=
TELEGRAM_STARTUP_CHAT_ID=
# Startup and graceful shutdown notifications share TELEGRAM_STARTUP_CHAT_ID.
TELEGRAM_RUNNER_CHAT_ID=
ENABLED_CHAINS=sol,bsc,robinhood
GMGN_PROVIDER=mock
GMGN_API_KEY=
# Optional top-100 holder and linked-funding analysis (additional GMGN quota).
GMGN_HOLDER_ANALYSIS_ENABLED=false
# Enrichment activates when the corresponding key is nonempty. Never share keys.
SOLANA_TRACKER_API_KEY=
HELIUS_API_KEY=
MADEONSOL_API_KEY=
MADEONSOL_ENABLED=true
FOMO_API_KEY=
FOMO_ENABLED=true
FOMO_LEADERBOARD_WINDOW=7d
ENRICHMENT_CACHE_SEC=300
RUNNER_ENABLED=false
# Legacy: polling intervals now use /setconfig <section>.pollIntervalSec
RUNNER_INTERVAL_SECONDS=300
RUNNER_STATE_FILE=data/runners.json
TELEGRAM_ADMIN_IDS=
LOG_LEVEL=info
BOT_SHUTDOWN_TIMEOUT_SEC=25
BOT_HEALTH_ENABLED=false
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=3101
BOT_HEALTH_TOKEN=
