{
  "name": "solana-token-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "On-demand Solana token intelligence scanner for Telegram.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s tests -p '*_test.py'",
    "lint": "eslint . --ext .ts",
    "api:dev": "tsx --env-file=.env apps/api/src/server.ts",
    "telegram:dev": "tsx --env-file=.env apps/telegram/src/bot.ts",
    "research:build-dataset": "python3 research/scripts/build_dataset.py",
    "research:label-outcomes": "python3 research/scripts/label_outcomes.py"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "grammy": "^1.38.1",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
