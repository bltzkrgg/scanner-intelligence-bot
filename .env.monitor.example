# Run this monitor separately; do not run Telegram getUpdates here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITOR_CHAT_ID=
# Same secret as BOT_HEALTH_TOKEN on the monitored bot; at least 32 characters.
BOT_HEALTH_TOKEN=
BOT_HEALTH_URL=http://127.0.0.1:3101/health
BOT_MONITOR_POLL_INTERVAL_SEC=15
BOT_MONITOR_TIMEOUT_SEC=120
BOT_MONITOR_STATE_FILE=data/bot-monitor.json
LOG_LEVEL=info
